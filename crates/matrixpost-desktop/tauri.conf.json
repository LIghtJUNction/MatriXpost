{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatriXpost",
  "version": "0.1.0",
  "identifier": "org.lightjunction.matrixpost",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "MatriXpost",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
